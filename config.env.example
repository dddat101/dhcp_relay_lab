# ==============================================================================
# DHCP Relay Functional Test Lab
# Copy to config.env and adjust only values that differ in your lab.
# ==============================================================================

# ------------------------------------------------------------------------------
# Physical test interfaces on Ubuntu PC
# IMPORTANT:
# - Dedicated NICs only.
# - Do not use an interface that carries the host default route.
# - LAN_TEST_IF connects physically to DUT LAN.
# - SRV_TEST_IF connects physically to DUT WAN/upstream side.
# ------------------------------------------------------------------------------
LAN_TEST_IF="enx_lan_test"
SRV_TEST_IF="enx_srv_test"

# ------------------------------------------------------------------------------
# Topology mode:
# - physical: (Default) Dedicated hardware NICs connected to physical DUT
# - virtual:  No physical DUT or NICs needed; simulates DHCP Relay in ns-relay
# ------------------------------------------------------------------------------
TOPOLOGY_MODE="physical"

# ------------------------------------------------------------------------------
# Network namespaces
# ------------------------------------------------------------------------------
NS_CLIENT="ns-lan1"
NS_SERVER="ns-srv"
NS_RELAY="ns-relay"

# Interface names after moving into namespaces.
NS_CLIENT_IF="eth0"
NS_SERVER_IF="eth0"

# ------------------------------------------------------------------------------
# Test addressing
# Client-facing subnet is selected by DHCP relay giaddr.
# Server-facing subnet carries relay <-> DHCP server traffic.
# ------------------------------------------------------------------------------
CLIENT_SUBNET="10.10.0.0"
CLIENT_NETMASK="255.255.255.0"
CLIENT_PREFIX="24"
CLIENT_POOL_START="10.10.0.100"
CLIENT_POOL_END="10.10.0.150"
DUT_LAN_IP="10.10.0.1"

CLIENT2_SUBNET="192.168.2.0"
CLIENT2_NETMASK="255.255.255.0"
CLIENT2_PREFIX="24"
CLIENT2_POOL_START="192.168.2.100"
CLIENT2_POOL_END="192.168.2.150"
DUT_LAN2_IP="192.168.2.1"

SERVER_IP="172.20.0.10"
SERVER_PREFIX="24"
DUT_WAN_IP="172.20.0.1"
WAN_SUBNET="172.20.0.0"
WAN_NETMASK="255.255.255.0"
WAN_POOL_START="172.20.0.20"
WAN_POOL_END="172.20.0.50"

DHCP_LEASE_TIME="300"
DHCP_DNS_IP="172.20.0.10"

# ------------------------------------------------------------------------------
# Capture and runtime directories
# ------------------------------------------------------------------------------
CAPTURE_DIR="captures"
STATE_DIR="state"

# Capture filter. Keep DHCP-only by default.
CAPTURE_FILTER="udp port 67 or udp port 68"
TSHARK_BIN="tshark"
TCPDUMP_BIN="tcpdump"

# ------------------------------------------------------------------------------
# DHCP server
# dnsmasq is used only as an application service inside ns-srv.
# ------------------------------------------------------------------------------
DNSMASQ_BIN="dnsmasq"

# ------------------------------------------------------------------------------
# DHCP client selection: auto | dhclient | udhcpc
# ------------------------------------------------------------------------------
DHCP_CLIENT="auto"
DHCLIENT_BIN="dhclient"
UDHCPC_BIN="udhcpc"
DHCP_TIMEOUT_SEC="20"

# ------------------------------------------------------------------------------
# Optional DUT SSH integration.
# Leave DUT_SSH_HOST empty to keep DUT configuration manual.
# Never put passwords in this file.
# ------------------------------------------------------------------------------
DUT_SSH_HOST=""
DUT_SSH_USER="root"
DUT_SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=5"

# Optional read-only commands for diagnostics.
DUT_SHOW_RELAY_CMD=""
DUT_SHOW_ROUTE_CMD="ip route"
DUT_SHOW_ADDR_CMD="ip -4 addr"

# Optional operator-provided commands.
# These are NOT executed automatically by setup.sh.
# scenario.sh can execute them only when RUN_DUT_CONFIG=1.
DUT_RELAY_ENABLE_CMD=""
DUT_RELAY_DISABLE_CMD=""
RUN_DUT_CONFIG="0"

# ------------------------------------------------------------------------------
# Scenario behavior
# ------------------------------------------------------------------------------
START_CAPTURE_AUTOMATICALLY="1"
VERIFY_GIADDR="1"
EXPECTED_RELAY_HOPS="1"
